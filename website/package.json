{
  "name": "drecksau",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "murdoku": "npx --yes tsx --tsconfig tsconfig.json scripts/murdoku-check.ts",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "docs": "typedoc",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:upgrade": "npx --yes npm-check-updates -u && npm install"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typedoc": "^0.28.20",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
